# Safe defaults. Keep both false until Max explicitly approves live checkout and fulfillment.
COMMERCE_CATALOG_APPROVED=false
COMMERCE_CHECKOUT_ENABLED=false
COMMERCE_FULFILLMENT_ENABLED=false
COMMERCE_VENDOR_MODE=sandbox

# Public site origin used for Stripe return URLs (server-side validation still applies).
SITE_URL=http://localhost:3000

# Airtable (server-only). Personal access token needs data.records:write on the base.
# Base appiWkCMQz8kfJvOl = "To Bee Honest" (owned by Nicolas; Foreman AI has Creator access).
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appiWkCMQz8kfJvOl
AIRTABLE_MARKETPLACE_TABLE_ID=tbl3XaHLIZlkriMNb

# Stripe (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DECK=
STRIPE_PRICE_PUZZLE_SUN_BIRD=
STRIPE_SHIPPING_RATE_PUZZLE_US=
STRIPE_PRICE_FRAME_12X16_GOLD=
STRIPE_PRICE_FRAME_12X16_SECOND=
STRIPE_PRICE_FRAME_20X28_GOLD=
STRIPE_PRICE_FRAME_20X28_SECOND=

# Prodigi (server-only). Exact SKUs and second frame color require approval.
PRODIGI_API_KEY=
PRODIGI_SKU_FRAME_12X16_GOLD=
PRODIGI_SKU_FRAME_12X16_SECOND=
PRODIGI_SKU_FRAME_20X28_GOLD=
PRODIGI_SKU_FRAME_20X28_SECOND=
PRODIGI_SECOND_FRAME_COLOR=pending-approval
PRODIGI_ASSET_BASE_URL=

# Sun Bird puzzle custom fulfillment (server-only). Keep fulfillment disabled until
# Claude's custom API adapter and signed/idempotent order contract are implemented.
PUZZLE_FULFILLMENT_SKU=
PUZZLE_FULFILLMENT_API_URL=
PUZZLE_FULFILLMENT_API_KEY=

# Keep false until OAuth, product, and design values have been verified with one real order.
QPMN_ENABLED=false
# Optional OAuth public client id; blank uses the id shipped in QPMN's official plugin.
QPMN_CLIENT_ID=
# Server-only OAuth refresh token issued for the To Bee Honest QPMN partner store.
QPMN_REFRESH_TOKEN=
# QPMN dashboard product id for the 54-card mantra deck.
QPMN_PRODUCT_ID_DECK=
# QPMN builder design id for the approved 54-card mantra deck artwork.
QPMN_DESIGN_ID_DECK=
# Existing checkout metadata identifier; retained for paid Stripe session compatibility.
QPMN_DECK_SKU=

# Order-intent capture (launch mode — no payment)
RESEND_API_KEY=
ORDER_ALERT_TO=kel@4manai.com,bettinger.nicolas@gmail.com
AIRTABLE_GALLERY_TABLE_ID=tblircNYKsWQXFEa3
AIRTABLE_DECK_TABLE_ID=tblVEa5PvIY9GIhMR

# The Game Crafter — mantra deck fulfilment (replaces QPMN, decided 2026-08-09).
# Obtain TGC_API_KEY_ID by setting the developer flag on the TGC account profile,
# which reveals an API-keys tab. NOTE: TGC publishes no sandbox host — every call is
# production, so COMMERCE_FULFILLMENT_ENABLED gates all of it.
TGC_USERNAME=
TGC_PASSWORD=
TGC_API_KEY_ID=
TGC_DECK_SKU=

# Duplicate-fulfilment guard. One row per paid Stripe session, written before any
# vendor call. REQUIRED for vendors without their own idempotency (TGC/QPMN) — fulfilment
# fails closed without it. Columns: Stripe Session, Vendor, SKU, Quantity, Stage,
# Claimed At, Cart ID, Receipt ID, Shipping Method, Shipping Cost, Error.
AIRTABLE_FULFILLMENT_TABLE_ID=
# Who hears about a stalled order or an empty pre-funded vendor balance. This is the
# person who FUNDS the vendor account (Nicolas), not the operator. No default on
# purpose — unset logs and skips rather than falling back to a hardcoded address.
FUNDING_ALERT_TO=
